(executable
 (name run)
 (flags (:standard -g))
 (libraries miniml unix))

(rule
 (alias run)
 (deps ../runtime/libruntime.a)
 (action
  (run %{exe:run.exe} )))

(rule
 (alias runtest)
 (deps
 {exe:run.exe}  ../runtime/libruntime.a
 (glob_files t*.ml)
 (glob_files t*.expected))
 (targets t01.out t02.out t03.out t04.out)
 (action
  (progn

   (with-stdout-to t01.out
     (run %{exe:run.exe} %{dep:t01.ml}))
   (diff t01.out %{dep:t01.expected})

   (with-stdout-to t02.out
     (run %{exe:run.exe} %{dep:t02.ml}))
   (diff t02.out %{dep:t02.expected})

   (with-stdout-to t03.out
     (run %{exe:run.exe} %{dep:t03.ml}))
   (diff t03.out %{dep:t03.expected})

   (with-stdout-to t04.out
     (run %{exe:run.exe} %{dep:t04.ml}))
   (diff t04.out %{dep:t04.expected})


   )))
